# Copy this file to .env and change values. Never commit .env (it holds secrets).
ENVIRONMENT=dev
LOG_LEVEL=INFO
# 127.0.0.1 instead of "localhost": on Windows, localhost tries IPv6 first and adds ~1s delay
DATABASE_URL=postgresql+psycopg://noteshub:noteshub@127.0.0.1:5432/noteshub
CORS_ORIGINS=["http://localhost:8080"]
